---
import type { Words } from "@src/compute";

interface Props {
  result: Words;
}

const { result } = Astro.props;
---

<section>
  <h1>Word counts</h1>
  <p class="digest">{`words ${result.total} ${result.distinct} ${result.top.map((w) => `${w.word}:${w.count}`).join(",")}`}</p>
  <ol>
    {result.top.map((w) => <li>{w.word} {w.count}</li>)}
  </ol>
</section>
