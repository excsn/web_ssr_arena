---
import Shell from "../../layouts/Shell.astro";
import WordsView from "@src/views/Words.astro";
import { words } from "@src/compute";

const passes = Math.min(Math.max(Number(Astro.url.searchParams.get("passes") ?? "20") || 0, 1), 1000);
---

<Shell>
  <WordsView result={words(passes)} />
</Shell>
